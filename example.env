# Variabel untuk Google Gemini API
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
DEFAULT_MODEL="gemini-1.5-flash"

# Variabel untuk Google Sheets API (gunakan path ke file kredensial JSON Anda)
GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/google-credentials.json"
SPREADSHEET_ID="YOUR_GOOGLE_SPREADSHEET_ID_HERE"

# Variabel untuk Proxy SOCKS5 (jika diperlukan untuk merutekan traffic API)
# Contoh: Jika proxy berjalan di localhost port 40000
SOCKS_PROXY_HOST="127.0.0.1"
SOCKS_PROXY_PORT="40000"

# Variabel untuk konfigurasi Cron Job
SYSTEM_TIMEZONE="Asia/Jakarta"
WHITELIST_NUMBERS="62812xxxxxxx,62878xxxxxxx" # Daftar nomor WhatsApp dipisahkan koma
CRON_JADWAL_REMINDER="0 20 * * *" # Contoh: Setiap hari jam 8 malam
CRON_JADWAL_REPORT="0 9 1 * *" # Contoh: Setiap tanggal 1 jam 9 pagi